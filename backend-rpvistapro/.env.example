# Copie este arquivo para .env e preencha os valores.
# MongoDB - escolha UMA das opções abaixo:

# --- Opção 1: MongoDB Atlas (nuvem) - precisa de internet
# Pegue a connection string no painel do Atlas (Connect > Connect your application).
# Substitua <password> pela senha do usuário do banco.
# MONGODB_URI=mongodb+srv://usuario:<password>@cluster0.xxxxx.mongodb.net/meubanco?retryWrites=true&w=majority

# --- Opção 2: MongoDB local (para testar sem internet)
# Instale o MongoDB no Mac (brew install mongodb-community) ou use Docker.
MONGODB_URI=mongodb://localhost:27017

# Porta do servidor (opcional)
# PORT=4001

# Configuração de Email
# Escolha UMA das opções abaixo:

# --- Opção 1: Gmail (para desenvolvimento/teste)
# EMAIL_SERVICE=gmail
# EMAIL_USER=seu-email@gmail.com
# EMAIL_PASSWORD=sua-app-password  # Use "App Password" do Gmail, não a senha normal

# --- Opção 2: SendGrid (recomendado para produção)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASSWORD=SG.sua-api-key-do-sendgrid
# EMAIL_FROM=noreply@rpvistapro.com.br

# --- Opção 3: AWS SES (recomendado se já usa AWS)
# SMTP_HOST=email-smtp.sa-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=seu-access-key-id
# SMTP_PASSWORD=sua-secret-access-key
# EMAIL_FROM=noreply@rpvistapro.com.br

# URL do frontend (para links nos emails)
# FRONTEND_URL=https://rpvistapro.com.br
